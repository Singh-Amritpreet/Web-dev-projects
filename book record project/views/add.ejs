<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Book</title>
    <link rel="stylesheet" href="/css/add-book.css">
</head>
<body>

    <div class="container">
        <h1>Add New Book</h1>

        <form action="/add" method="POST">

            <div class="form-group">
                <label for="isbn">ISBN</label>
                <input
                    type="text"
                    id="isbn"
                    name="isbn"
                    placeholder="9780743273565"
                    required
                >
            </div>

            <div class="form-group">
                <label for="title">Book Title</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="The Great Gatsby"
                    required
                >
            </div>

            <div class="form-group">
                <label for="author">Author</label>
                <input
                    type="text"
                    id="author"
                    name="author"
                    placeholder="F. Scott Fitzgerald"
                    required
                >
            </div>

            <div class="form-group">
                <label for="date_read">Date Read</label>
                <input
                    type="date"
                    id="date_read"
                    name="date_read"
                    required
                >
            </div>

            <div class="form-group">
                <label for="rating">Rating (1-10)</label>
                <input
                    type="number"
                    id="rating"
                    name="rating"
                    min="1"
                    max="10"
                    required
                >
            </div>

            <div class="form-group">
                <label for="review">Review / Summary</label>
                <textarea
                    id="review"
                    name="review"
                    rows="8"
                    placeholder="Write your thoughts about the book..."
                    required
                ></textarea>
            </div>

            <button type="submit">Add Book</button>

        </form>
    </div>

</body>
</html>