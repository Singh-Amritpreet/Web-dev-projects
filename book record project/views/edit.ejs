<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
    <link rel="stylesheet" href="/css/edit-book.css">
</head>
<body>

    <div class="container">

        <h1>Edit Book</h1>

        <form action="/edit/<%= book.isbn %>" method="POST">

            <div class="form-group">
                <label>ISBN</label>
                <input
                    type="text"
                    name="isbn"
                    value="<%= book.isbn %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Title</label>
                <input
                    type="text"
                    name="title"
                    value="<%= book.title %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Author</label>
                <input
                    type="text"
                    name="author"
                    value="<%= book.author %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Date Read</label>
                <input
                    type="date"
                    name="date_read"
                    value="<%= book.date_read.toISOString().split('T')[0] %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Rating</label>
                <input
                    type="number"
                    min="1"
                    max="10"
                    name="rating"
                    value="<%= book.rating %>"
                    required
                >
            </div>

            <div class="form-group">
                <label>Review</label>
                <textarea
                    name="review"
                    rows="10"
                    required
                ><%= book.review %></textarea>
            </div>

            <button type="submit">
                Save Changes
            </button>

        </form>

    </div>

</body>
</html>